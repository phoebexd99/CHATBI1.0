# Runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=live

# Database (Docker default). For no-Docker local verification use sqlite:///./chatbi.db
DATABASE_URL=postgresql://chatbi:change-me-locally@postgres:5432/chatbi
POSTGRES_DB=chatbi
POSTGRES_USER=chatbi
POSTGRES_PASSWORD=change-me-locally

# OpenAI-compatible model endpoint. Never commit real values.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional WrenAI Core/SDK adapter. Empty uses the deterministic local adapter.
WREN_BASE_URL=
WREN_API_KEY=
WREN_TIMEOUT_SECONDS=15


# Local development through the Tencent Cloud PostgreSQL SSH tunnel.
# These values are safe to keep locally; never put an SSH password/private key in Git.
SSH_HOST=115.159.67.119
SSH_PORT=22
SSH_USER=ubuntu
SSH_KEY_PATH=C:\Users\<your-user>\.ssh\codexssh.pem
SSH_LOCAL_PORT=15432
SSH_REMOTE_HOST=127.0.0.1
SSH_REMOTE_PORT=5432
